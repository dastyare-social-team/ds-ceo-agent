# ── Model routing ────────────────────────────────────────────────────────────
# Leave OPENROUTER_API_KEY empty to use the built-in free chain only. The agent
# uses OpenRouter free models exclusively, ordered by max context, with automatic
# failover — there is no paid fallback, because the key ships with no credits.
OPENROUTER_API_KEY=

# Appends OpenCode Zen models to the end of the chain as a cross-provider safety
# net, for when the whole OpenRouter free pool is unavailable. Set to 1 to enable.
# Most Zen "free" models reject non-OpenCode clients; only the ones that actually
# run are listed in src/mastra/model.ts.
OPENCODE_API_KEY=
OPENCODE_FREE_MODELS=0

# Pin a single model and disable the fallback chain. Intended for A/B testing
# one model and for reproducing a bad reply. Leave empty for normal operation.
# MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# ── Telegram ─────────────────────────────────────────────────────────────────
# @botfather token for the bot that fronts the agent.
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token. Without it
# the webhook returns 401. Any random string works.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# "webhook" (default, required on Vercel) or "longpolling" (local only).
TELEGRAM_MODE=webhook

# Comma-separated Telegram user IDs allowed to use the bot. Everyone else is
# rejected before the agent runs — no model call, no tools, no storage write.
# This list is the entire security boundary; anyone omitted has no access.
TELEGRAM_ALLOWED_USER_IDS=

# ── Storage ──────────────────────────────────────────────────────────────────
# Required. Neon Postgres. The bot throws at boot without it.
# sslmode=verify-full verifies the server certificate and hostname. An incoming
# sslmode=require is upgraded to verify-full automatically.
DATABASE_URL=

# Shared pub/sub. Without it, two Vercel instances can handle the same Telegram
# update and reply twice. Only needed in production, where more than one instance
# can run; safe to leave empty locally.
REDIS_URL=

# ── Tools ────────────────────────────────────────────────────────────────────
# Tavily powers the agent's web_search and extract tools. Without it those tools
# are disabled and the agent answers from model knowledge only.
TAVILY_API_KEY=

# Mastra Studio. Keep false in production — the Studio must not be reachable.
MASTRA_STUDIO=false
