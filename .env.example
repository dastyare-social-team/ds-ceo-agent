# ── Model routing ────────────────────────────────────────────────────────────
# Two free tiers, tried in this order: OpenCode Zen first, then OpenRouter.
# Mastra walks the list in order and fails over on error, so the user never sees
# a model failure. See "Model routing" in the README.

# PRIMARY tier. OpenCode Zen is attempted first. Only one Zen free model is
# reachable from a server — the other nine are restricted to the OpenCode client —
# so this key is what makes the agent run on Zen at all. Remove it to run
# OpenRouter-only, which is a valid configuration.
OPENCODE_API_KEY=

# FALLBACK tier, used when Zen is unset or unavailable. The agent uses OpenRouter
# free models exclusively, ordered by max context. There is no paid fallback:
# the key ships with no credits, so a paid slug would fail on every call.
OPENROUTER_API_KEY=

# Pin a single model and disable the whole chain. Intended for A/B testing one
# model and for reproducing a bad reply. Leave empty for normal operation.
# Accepts a Zen id or an OpenRouter id, e.g.:
#   MODEL=opencode/space-bunny-free
#   MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# ── Telegram ─────────────────────────────────────────────────────────────────
# @botfather token for the bot that fronts the agent.
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token. Without it
# the webhook returns 401. Any random string works.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# "webhook" (default, required on Vercel) or "longpolling" (local only).
TELEGRAM_MODE=webhook

# Comma-separated Telegram user IDs allowed to use the bot. Everyone else is
# rejected before the agent runs — no model call, no tools, no storage write.
# This list is the entire security boundary; anyone omitted has no access.
TELEGRAM_ALLOWED_USER_IDS=

# ── Storage ──────────────────────────────────────────────────────────────────
# Required. Neon Postgres. The bot throws at boot without it.
# sslmode=verify-full verifies the server certificate and hostname. An incoming
# sslmode=require is upgraded to verify-full automatically.
DATABASE_URL=

# Connection string for shared pub/sub. Kept for future use, but see below.
REDIS_URL=

# Shared pub/sub is OFF unless this is 1. On @mastra/core 1.71.0, constructing
# Mastra with RedisStreamsPubSub deadlocks agent.stream() — the call never
# resolves, before any chunk — and the Telegram channel streams. With it on, every
# inbound message hangs: the webhook returns 200, Telegram sees a successful
# delivery, never retries, and the bot never replies. A live bot that answers
# once is worth more than the risk of a duplicate reply; deduplicate another way
# (single Vercel instance, or a queue) and set this to 1 once upstream is fixed.
REDIS_PUBSUB=0

# ── Tools ────────────────────────────────────────────────────────────────────
# Tavily powers the agent's web_search and extract tools. Without it those tools
# are disabled and the agent answers from model knowledge only.
TAVILY_API_KEY=

# Mastra Studio. Keep false in production — the Studio must not be reachable.
MASTRA_STUDIO=false
